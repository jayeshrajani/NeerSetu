# GhatWatch works fully without any of these. Copy to .env.local only if you want AI-assisted wording.
# AI_PROVIDER: none | anthropic | cerebras | openai_compatible
AI_PROVIDER=none
# Model ID exactly as your provider account lists it (no default is assumed).
AI_MODEL=
AI_TIMEOUT_MS=12000

ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
# Optional override for Cerebras; defaults to https://api.cerebras.ai/v1
CEREBRAS_BASE_URL=

# Generic OpenAI-compatible chat/completions endpoint (server-side only).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

